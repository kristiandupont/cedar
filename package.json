{
  "name": "cedar",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/backend.cjs",
  "exports": {
    "./backend": {
      "require": "./dist/backend.cjs",
      "default": "./dist/backend.cjs",
      "types": "./dist/backend.d.cts"
    },
    "./frontend": {
      "require": "./dist/frontend.cjs",
      "default": "./dist/frontend.cjs",
      "types": "./dist/frontend.d.cts"
    },
    "./auth": {
      "require": "./dist/auth.cjs",
      "default": "./dist/auth.cjs",
      "types": "./dist/auth.d.cts"
    },
    "./eslint": {
      "require": "./dist/eslint.cjs",
      "default": "./dist/eslint.cjs",
      "types": "./dist/eslint.d.cts"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs",
      "types": "./dist/testing.d.mts"
    },
    "./testing/db": {
      "require": "./dist/testing/db.cjs",
      "default": "./dist/testing/db.cjs",
      "types": "./dist/testing/db.d.cts"
    },
    "./kanel": "./kanel/index.js"
  },
  "typesVersions": {
    "*": {
      "backend": [
        "dist/backend.d.cts"
      ],
      "frontend": [
        "dist/frontend.d.cts"
      ],
      "auth": [
        "dist/auth.d.cts"
      ],
      "eslint": [
        "dist/eslint.d.cts"
      ],
      "testing": [
        "dist/testing.d.mts"
      ],
      "testing/db": [
        "dist/testing/db.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/ws": "^8.18.1",
    "jsonwebtoken": "^9.0.0",
    "pg-listen": "^1.7.0",
    "postgres-range": "^1.1.4",
    "react-geiger": "^1.0.2",
    "request-ip": "^3.3.0",
    "superjson": "^2.0.0",
    "workspace-sync": "github:kristiandupont/workspace-sync#main",
    "ws": "^8.20.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=4",
    "knex": ">=3",
    "narrow-types": ">=1",
    "pg": ">=8",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "kanel": {
      "optional": true
    },
    "kanel-knex": {
      "optional": true
    },
    "kanel-seeder": {
      "optional": true
    },
    "kanel-zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^4.36.1",
    "@types/pg": "^8.0.0",
    "@types/react": "^18.3.1",
    "@types/request-ip": "^0.0.41",
    "kanel": "^4.0.0",
    "kanel-knex": "^4.0.0",
    "kanel-seeder": "^4.0.0",
    "kanel-zod": "^4.0.0",
    "knex": "^3.0.0",
    "narrow-types": "^1.2.0",
    "oxlint": "^1.78.0",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6",
    "zod": "^3.21.4"
  }
}
